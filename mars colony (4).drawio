  <diagram name="State Machine Diagram" id="stateDiagramV2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="stateDiagramV2-2" value="State Machine Diagrams" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-3" value="A. Mission lifecycle  (Mission.state : Mission_Emergency_States - ASSIGNED, INPROGRESS, COMPLETED, FAILED; null = not yet accepted)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="56" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="143" y="150" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-5" value="NEW&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;state = null&lt;br/&gt;(created, not yet accepted)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-6" value="ASSIGNED&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;active mission&lt;br/&gt;agents unavailable&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-7" value="IN_PROGRESS&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;(INPROGRESS in code)&lt;br/&gt;elapsed counts up&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="250" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-8" value="COMPLETED&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;agents released&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1520" y="250" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-9" value="FAILED&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;failureReason set&lt;br/&gt;agents released&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="600" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-10" value="" style="shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1">
          <mxGeometry x="1603" y="420" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-11" value="" style="shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="630" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="stateDiagramV2-4" target="stateDiagramV2-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-13" value="submitMission(mission, agents)&lt;br/&gt;[every check passes]&lt;br/&gt;/ assign(each agent), activeMission = mission" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="stateDiagramV2-5" target="stateDiagramV2-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-14" value="submitMission(mission, agents)&lt;br/&gt;[any check fails: no agents | another mission active |&lt;br/&gt;agent unavailable or cannot perform | bad team |&lt;br/&gt;environment restriction | insufficient resources]&lt;br/&gt;/ rejectMission(reason) - never becomes active" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;dashed=1;" edge="1" parent="1" source="stateDiagramV2-5" target="stateDiagramV2-9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="155" y="645" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="stateDiagramV2-15" value="startActiveMission()&lt;br/&gt;[battery enough AND resources reserved]&lt;br/&gt;/ deduct resources, elapsed = 0" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="stateDiagramV2-6" target="stateDiagramV2-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-16" value="startActiveMission() [battery too low OR resources gone]&lt;br/&gt;| failActiveMission(reason) | rover breakdown&lt;br/&gt;/ failMission(reason)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;dashed=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="stateDiagramV2-6" target="stateDiagramV2-9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="470" />
              <mxPoint x="885" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="stateDiagramV2-17" value="advanceTimeUnit() [environment restriction: dust storm + rover,&lt;br/&gt;comms loss + drone / rescue | agent battery runs out]&lt;br/&gt;| rover breakdown | failActiveMission(reason) | finishMission(false)&lt;br/&gt;/ failMission(reason), release agents" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;dashed=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="stateDiagramV2-7" target="stateDiagramV2-9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1165" y="560" />
              <mxPoint x="995" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="stateDiagramV2-18" value="advanceTimeUnit()&lt;br/&gt;[elapsed &gt;= neededTimeUnits]&lt;br/&gt;/ onSuccessfulCompletion(),&lt;br/&gt;release agents" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="stateDiagramV2-7" target="stateDiagramV2-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-19" value="advanceTimeUnit()&lt;br/&gt;[elapsed &lt; neededTimeUnits]&lt;br/&gt;/ elapsed++, agents drain battery" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="stateDiagramV2-7" target="stateDiagramV2-7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1112" y="190" />
              <mxPoint x="1217" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="stateDiagramV2-20" value="unassign(last agent)&lt;br/&gt;[no agents left]  / state = null" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;exitX=0.25;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="1" source="stateDiagramV2-6" target="stateDiagramV2-5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="190" />
              <mxPoint x="221" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="stateDiagramV2-21" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="stateDiagramV2-8" target="stateDiagramV2-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-22" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=11;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="stateDiagramV2-9" target="stateDiagramV2-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-23" value="&lt;b&gt;Rules shown by this diagram&lt;/b&gt;&lt;br/&gt;1. A mission is accepted only if all submission checks pass; otherwise it goes straight NEW -&gt; FAILED, with a reason, and is never the active mission.&lt;br/&gt;2. Only ONE mission can be active (ASSIGNED or IN_PROGRESS) at a time.&lt;br/&gt;3. ASSIGNED -&gt; IN_PROGRESS is explicit: Colony.startActiveMission() (the GUI &quot;Start Active Mission&quot; button).&lt;br/&gt;4. Each time unit (Simulation.advanceTime) advances an IN_PROGRESS mission by exactly one unit.&lt;br/&gt;5. COMPLETED and FAILED are final. A failed mission is NEVER retried - create a new Mission to try again.&lt;br/&gt;6. On COMPLETED or FAILED every assigned agent is made available again." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-24" value="&lt;b&gt;Submission checks, in the order Colony.submitMission() runs them&lt;/b&gt;&lt;br/&gt;1. agents list not null / not empty&lt;br/&gt;2. no other mission is active&lt;br/&gt;3. for each agent: not null, not duplicated, available, canPerform(mission)&lt;br/&gt;4. mission.hasValidTeamComposition(agents)&lt;br/&gt;5. MarsEnvironment.getMissionRestrictionReason(...) is null&lt;br/&gt;6. mission.checkresources(colony-wide totals) is true" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="850" y="740" width="860" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-25" value="B. Emergency lifecycle  (Emergency.status : EmergencyStatus)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="960" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stateDiagramV2-26" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="56" y="1070" width="24" height="24" as="geometry" />
        </mxCell>
